# Copiar a .env y completar.
# MOCK_LLM=true hace que el backend ande sin credenciales.

MOCK_LLM=true

# Google AI Studio: https://aistudio.google.com/apikey
# Modelos flash disponibles en el free tier. Verificá con:
#   python -c "from google import genai; c=genai.Client(); print([m.name for m in c.models.list()])"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (se usa en el frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
