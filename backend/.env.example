# Copiar a .env y completar.
# MOCK_LLM=true hace que el backend ande sin credenciales.

MOCK_LLM=true

# Google AI Studio: https://aistudio.google.com/apikey
# Modelos flash disponibles en el free tier. Verificá con check_quota.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase. El backend valida el JWT del usuario contra estos mismos valores,
# así que los necesita también: sin ellos no puede saber quién llama.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ejecuciones por usuario y por día. El dashboard es público y cada corrida
# gasta cuota compartida del free tier de Gemini.
DAILY_RUN_LIMIT=5

# Solo para desarrollo local: acepta cualquier request como un único usuario
# compartido. NO usar en un despliegue real, desactiva el límite por persona.
ALLOW_ANONYMOUS=false
