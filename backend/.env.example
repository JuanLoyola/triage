# Copiar a .env y completar.
# MOCK_LLM=true hace que el backend ande sin credenciales.

MOCK_LLM=true

# Google AI Studio: https://aistudio.google.com/apikey
# Modelos flash disponibles en el free tier. Verificá con check_quota.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Límite por sesión de navegador, por día. Cada visita arranca con su propio
# presupuesto, así que un visitante no gasta el de otro.
DAILY_RUN_LIMIT=3

# Techo global diario, entre todas las sesiones. El id de sesión viene del
# cliente y se puede limpiar, así que esto es lo que protege la cuota cuando
# alguien genera ids nuevos a propósito.
DAILY_GLOBAL_LIMIT=50
